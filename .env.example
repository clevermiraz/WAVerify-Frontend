# Origin of the WAVerify API — scheme and host only, no path.
# The /api/v1 prefix is added by src/lib/api-client.ts.
# Production: https://api.waverify.app
# Inlined into the client bundle at build time, so a Docker image must be
# rebuilt (not just restarted) to point at a different API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public origin of this site, used for canonical URLs, Open Graph tags,
# robots.txt and sitemap.xml. Read at build time. Defaults to production.
SITE_URL=http://localhost:3000

# Google OAuth client ID for "Continue with Google".
# Public by design — it identifies the app to Google and is visible in the
# browser either way. The client *secret* is never needed here; the backend
# verifies the ID token. Leave empty to hide the Google buttons.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
